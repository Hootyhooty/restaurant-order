MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/restaurant?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email
# EMAIL_MODE=sandbox  -> Mailtrap Email Testing (messages stay in your Mailtrap inbox, never reach real users)
# EMAIL_MODE=production -> real delivery via SMTP_* below (requires a verified sending domain)
EMAIL_MODE=sandbox
EMAIL_FROM=Picha <noreply@picha-restaurant.com>
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_HOURS=1
# EMAIL_SKIP_SEND=true

# Mailtrap sandbox (Email Testing → Inbox → SMTP) — used when EMAIL_MODE=sandbox
MAILTRAP_SANDBOX_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SANDBOX_PORT=2525
MAILTRAP_SANDBOX_USER=
MAILTRAP_SANDBOX_PASS=

# Production SMTP (used when EMAIL_MODE=production). Configured for Resend.
# Go live: add picha-restaurant.com in Resend, add its SPF/DKIM DNS records, create an API key,
# then set EMAIL_MODE=production and paste the API key as SMTP_PASS.
#   SMTP_USER is the literal string "resend"; SMTP_PASS is your Resend API key (re_...).
# Other providers work too by swapping these values:
#   Mailtrap Sending: SMTP_HOST=live.smtp.mailtrap.io   SMTP_USER=api     SMTP_PASS=<token>
#   SendGrid:         SMTP_HOST=smtp.sendgrid.net        SMTP_USER=apikey  SMTP_PASS=<api-key>
#   Brevo:            SMTP_HOST=smtp-relay.brevo.com     SMTP_USER=<login> SMTP_PASS=<key>
# EMAIL_MODE=production
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=240
RATE_LIMIT_BOOKING_WINDOW_MS=60000
RATE_LIMIT_BOOKING_MAX=15
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=120

# Ops alert thresholds (Day 9 monitoring)
ALERT_BOOKING_FAIL_RATE_PCT=20
ALERT_BOOKING_CONFLICT_RATE_PCT=10
ALERT_WEBHOOK_P95_MS=3000
ALERT_REFUND_BACKLOG_MAX=5
ALERT_API_P95_MS=500
ALERT_WEBHOOK_FAIL_COUNT=3

# Staging smoke (npm run staging:smoke)
# STAGING_API_URL=https://your-staging-api.onrender.com
# STAGING_FRONTEND_ORIGIN=https://your-staging-app.onrender.com
