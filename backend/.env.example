MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/restaurant?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
AUTH_SESSION_DAYS=30
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Payments and uploads
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Either CLOUDINARY_URL or the three CLOUD_* values may be used.
CLOUDINARY_URL=
CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=

# Email
# EMAIL_MODE=sandbox  -> Mailtrap Email Testing over SMTP (messages stay in your Mailtrap inbox, never reach real users)
# EMAIL_MODE=production -> real delivery via the Resend HTTP API (RESEND_API_KEY below)
EMAIL_MODE=sandbox
EMAIL_FROM=Picha <noreply@picha-restaurant.com>
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_HOURS=1
# EMAIL_SKIP_SEND=true

# Mailtrap sandbox (Email Testing → Inbox → SMTP) — used when EMAIL_MODE=sandbox
MAILTRAP_SANDBOX_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SANDBOX_PORT=2525
MAILTRAP_SANDBOX_USER=
MAILTRAP_SANDBOX_PASS=

# Production email (used when EMAIL_MODE=production) — Resend HTTP API.
# We use the HTTP API (not SMTP) because hosts like Render block outbound SMTP ports,
# which makes SMTP connections time out. The HTTP API uses port 443 and always works.
# Go live: add picha-restaurant.com in Resend, add its SPF/DKIM DNS records (DNS-only / no
# Cloudflare proxy), create an API key, then set EMAIL_MODE=production and the key below.
RESEND_API_KEY=

# Inbox for contact form submissions (defaults to info@picha-restaurant.com)
# CONTACT_INBOX=info@picha-restaurant.com
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=240
RATE_LIMIT_BOOKING_WINDOW_MS=60000
RATE_LIMIT_BOOKING_MAX=15
RATE_LIMIT_OPERATIONAL_WINDOW_MS=60000
RATE_LIMIT_OPERATIONAL_MAX=180
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=120

# Ops alert thresholds (Day 9 monitoring)
ALERT_BOOKING_FAIL_RATE_PCT=20
ALERT_BOOKING_CONFLICT_RATE_PCT=10
ALERT_WEBHOOK_P95_MS=3000
ALERT_REFUND_BACKLOG_MAX=5
ALERT_API_P95_MS=500
ALERT_WEBHOOK_FAIL_COUNT=3

# Staging smoke (npm run staging:smoke)
# STAGING_API_URL=https://your-staging-api.onrender.com
# STAGING_FRONTEND_ORIGIN=https://your-staging-app.onrender.com
# STAGING_SMOKE_USERNAME=
# STAGING_SMOKE_PASSWORD=
